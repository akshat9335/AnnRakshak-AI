# AnnRakshak AI — Environment Variables Template
# Copy this file to .env and insert your official Google Gen AI API key if live Gemma 4 inference is desired.
# Note: If no API key is provided, AnnRakshak AI operates seamlessly using its deterministic rule-based demo engine.

GEMINI_API_KEY=your_google_genai_api_key_here
GOOGLE_API_KEY=your_google_genai_api_key_here
